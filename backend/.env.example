# ====================================================================
# TRINETRA (त्रिनेत्र) — ENVIRONMENT & SECURITY CONFIGURATION TEMPLATE
# ====================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
PROJECT_NAME="TRINETRA"
PROJECT_DESCRIPTION="AI-Based Smart Governance & Compliance Monitoring System for Coal Mines"
API_V1_STR="/api/v1"

# Cryptographic Authentication & Security
# WARNING: Generate a secure 32+ character key for production (e.g., openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_SUPER_SECRET_PRODUCTION_KEY_32_BYTES_MINIMUM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite in local development)
DATABASE_URL=postgresql+psycopg2://trinetra_user:trinetra_secure_password@localhost:5432/trinetra_db

# CORS Configuration (Strict Allowed Origins in production)
CORS_ORIGINS=["http://localhost:5173","https://trinetra.gov.in","https://mines.trinetra.gov.in"]

# External Integrations & Simulation Flags
SIMULATED_TELEMETRY_ENABLED=true
CMSMS_ADAPTER_MODE=SIMULATED
PARIVESH_ADAPTER_MODE=SIMULATED
DGMS_ADAPTER_MODE=SIMULATED

# External Government Ecosystem Endpoints (Configurable when real credentials exist)
CMSMS_BASE_URL=https://cmsms.coal.gov.in/api/v1
PARIVESH_BASE_URL=https://parivesh.nic.in/api/v1
DGMS_BASE_URL=https://dgms.gov.in/api/v1

# Optional AI LLM API Key (For Google Gemini / Cloud LLM provider fallback)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
