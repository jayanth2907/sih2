# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="TRINETRA"

# Database (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///./trinetra.db
# DATABASE_URL=postgresql://trinetra_user:trinetra_password@localhost:5432/trinetra_db

# Security & Authentication (Change in production!)
JWT_SECRET=trinetra-dev-super-secret-key-32-bytes-long-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Asynchronous Tasks / Cache
REDIS_URL=redis://localhost:6379/0

# Document & Object Storage Abstraction (MinIO / S3)
OBJECT_STORAGE_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=trinetra_minio_access_key
OBJECT_STORAGE_SECRET_KEY=trinetra_minio_secret_key
OBJECT_STORAGE_BUCKET=trinetra-compliance-documents

# Telemetry Source Mode (SIMULATED / MQTT / SCADA)
SIMULATED_TELEMETRY_ENABLED=true
